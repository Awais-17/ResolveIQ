# ResolveIQ environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# ─── Google Cloud / Vertex AI ───────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Verify the exact ID in your GCP Model Garden; fall back to gemini-2.5-pro.
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_TEMPERATURE=1.0
GEMINI_MAX_RETRIES=2

# Embedding model for cross-ticket similarity (DO NOT change dims after seeding).
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
DEDUP_SIM_THRESHOLD=0.85

# ─── Vertex AI Search (managed RAG datastores) ─────────────────────
# Full resource path: projects/{project}/locations/global/collections/default_collection/dataStores/{id}
VERTEX_AI_SEARCH_KB_DATASTORE=resolveiq-kb
VERTEX_AI_SEARCH_CHANGELOG_DATASTORE=resolveiq-changelog
VERTEX_AI_SEARCH_TOP_K=5

# ─── Decision thresholds (tunable at runtime by feedback loop) ─────
CONFIDENCE_THRESHOLD=0.70
INCIDENT_TICKET_THRESHOLD=3
INCIDENT_WINDOW_MINUTES=20
RECENT_TICKETS_LEDGER_LIMIT=50

# ─── Firebase / Firestore ───────────────────────────────────────────
FIREBASE_PROJECT_ID=your-gcp-project-id          # usually same as GOOGLE_CLOUD_PROJECT
FIRESTORE_DATABASE=(default)
# Service account used by Cloud Run. Locally, ADC handles auth via:
# gcloud auth application-default login
ORCHESTRATOR_SERVICE_ACCOUNT=orchestrator@your-gcp-project-id.iam.gserviceaccount.com

# ─── Orchestrator runtime ──────────────────────────────────────────
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8080
LOG_LEVEL=INFO

# ─── Cloud Functions → Orchestrator HTTP bridge ────────────────────
# Used by functions/ingestion to POST new tickets to the orchestrator.
ORCHESTRATOR_URL=http://localhost:8080            # set to Cloud Run URL in prod

# ─── Dashboard ──────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-gcp-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
